{
  "description": "Normalise AI gateway logs to ai.* and apply data minimisation. Source field names (gateway.*) are examples: rename to match your gateway.",
  "processors": [
    {
      "rename": {
        "field": "gateway.app",
        "target_field": "ai.system.name",
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "field": "gateway.model",
        "target_field": "ai.model.name",
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "field": "gateway.model_version",
        "target_field": "ai.model.version",
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "field": "gateway.request_id",
        "target_field": "ai.request.id",
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "field": "gateway.tokens.input",
        "target_field": "ai.request.tokens_in",
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "field": "gateway.tokens.output",
        "target_field": "ai.request.tokens_out",
        "ignore_missing": true
      }
    },
    {
      "fingerprint": {
        "fields": [
          "gateway.api_key"
        ],
        "target_field": "ai.request.client_id",
        "method": "SHA-256",
        "salt": "CHANGE_ME",
        "ignore_missing": true
      }
    },
    {
      "fingerprint": {
        "fields": [
          "gateway.prompt"
        ],
        "target_field": "ai.request.prompt_hash",
        "method": "SHA-256",
        "salt": "CHANGE_ME",
        "ignore_missing": true
      }
    },
    {
      "remove": {
        "field": [
          "gateway.api_key",
          "gateway.prompt",
          "gateway.completion"
        ],
        "ignore_missing": true
      }
    },
    {
      "set": {
        "field": "ai.request.type",
        "value": "inference",
        "override": false
      }
    },
    {
      "set": {
        "field": "ai.guardrail.action",
        "value": "allow",
        "override": false
      }
    }
  ]
}
