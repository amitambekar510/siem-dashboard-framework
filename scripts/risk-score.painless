int score = 0;
if (doc.containsKey('winlog.event_id') && doc['winlog.event_id'].size() > 0) {
  long id = doc['winlog.event_id'].value;
  if (id == 1102) score += 10;
  if (id == 4732 || id == 4756) score += 8;
  if (id == 7045) score += 5;
}
if (doc.containsKey('auditd.log.AUID') && doc['auditd.log.AUID'].size() > 0
    && doc['auditd.log.AUID'].value.equals('4294967295')) score += 7;
if (doc.containsKey('auditd.log.key') && doc['auditd.log.key'].size() > 0
    && doc['auditd.log.key'].value.startsWith('DPIA_')) score += 6;
if (doc.containsKey('auditd.log.EUID') && doc['auditd.log.EUID'].size() > 0
    && doc['auditd.log.EUID'].value.equals('0')) score += 5;
if (doc.containsKey('event.outcome') && doc['event.outcome'].size() > 0
    && doc['event.outcome'].value.equals('failure')) score += 4;
if (doc.containsKey('auditd.log.success') && doc['auditd.log.success'].size() > 0
    && doc['auditd.log.success'].value.equals('no')) score += 3;
emit(score);
